# cicd settings for avela_tuner (copy to cicd/.env; .env is not committed).
# The repository to build and test from (default: this checkout's origin remote).
REPO_URL=
# Where the scripts work (default: build/ in this checkout): builds go to $BUILD_DIR/artifacts/<version>/, the fresh
# clones they build and test in to $BUILD_DIR/clones/ (CLONES_DIR overrides that).
BUILD_DIR=
# The branch build.sh builds without --tag / --version.
BUILD_BRANCH=main
